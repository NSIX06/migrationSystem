  quantidadeSolicitada       Decimal?  @db.Decimal(8,2) @map("quantidade_solicitada")
  quantidadeAtendida         Decimal?  @db.Decimal(8,2) @map("quantidade_atendida")
  quantidadeGlosa            Decimal?  @db.Decimal(8,2) @map("quantidade_glosa")
  quantidadeAutorizada       Decimal?  @db.Decimal(8,2) @map("quantidade_autorizada")
  valorUnitario              Decimal?  @db.Decimal(8,2) @map("valor_unitario")
  valorUnitarioGlosa         Decimal?  @db.Decimal(8,2) @map("valor_unitario_glosa")
  percentualCoparticipacao   Decimal?  @db.Decimal(8,2) @map("percentual_cooparticipacao")
  valorUnitarioCoparticipacao Decimal? @db.Decimal(8,2) @map("valor_unitario_coparticipacao")
  valorTotalCoparticipacao   Decimal?  @db.Decimal(8,2) @map("valor_total_coparticipacao")
  percentualItem             Decimal?  @db.Decimal(8,2) @map("percentual_item")
  quantidadeFaturada         Decimal?  @db.Decimal(8,2) @map("quantidade_faturada")
  valorUnitarioFaturado      Decimal?  @db.Decimal(8,2) @map("valor_unitario_faturado")
  valorTotalFaturado         Decimal?  @db.Decimal(8,2) @map("valor_total_faturado")
  valorTotal                 Decimal?  @db.Decimal(8,2) @map("valor_total")
  reducaoAcrescimo           Decimal?  @db.Decimal(8,2) @map("reducao_acrescimo")
  grauPart                   Int?      @map("grau_part")
  status                     StatusGuiaEnum @default(SOLICITADA)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  deletedAt                  DateTime? @map("deleted_at")

  guia        Guia?             @relation(fields: [guiaId], references: [id])
  auditoria   GuiaAuditoria[]
  atendimentos GuiaAtendimento[]
  historico   GuiaHistorico[]

  @@index([guiaId])
  @@index([status])
  @@map("guias_itens")
}

model GuiaHistorico {
  id          BigInt    @id @default(autoincrement())
  guiaId      BigInt    @map("guia_id")
  guiaItemId  BigInt?   @map("guia_item_id")
