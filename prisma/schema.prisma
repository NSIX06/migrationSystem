  indicadorPix                         String          @default("S") @db.VarChar(255) @map("indicador_pix")
  pixQrcode                            String?         @db.VarChar(255) @map("pix_qrcode")
  status                               StatusBoletoEnum @default(EMITIDO)
  dataBaixa                            DateTime?       @map("data_baixa") @db.Date
  boletoUrl                            String?         @map("boleto_url") @db.Text
  createdAt                            DateTime        @default(now()) @map("created_at")
  updatedAt                            DateTime        @updatedAt @map("updated_at")
  deletedAt                            DateTime?       @map("deleted_at")

