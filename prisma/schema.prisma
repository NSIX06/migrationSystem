  @@map("documentos_credenciamento")
}

model EditalCredenciamentoDocumento {
  editalId               BigInt   @map("edital_id")
  documentoCredenciamentoId BigInt @map("documento_credenciamento_id")
  obrigatorio            Boolean  @default(false)
  updatedAt              DateTime @updatedAt @map("updated_at")

  edital     EditalCredenciamento    @relation(fields: [editalId], references: [id])
  documento  DocumentoCredenciamento @relation(fields: [documentoCredenciamentoId], references: [id])

  @@id([editalId, documentoCredenciamentoId])
  @@map("edital_credenciamento_documentos")
}

model SolicitacaoCredenciamento {
  id                     BigInt                      @id @default(autoincrement())
  editalCredenciamentoId BigInt                      @map("edital_credenciamento_id")
  nome                   String                      @db.VarChar(255)
  tipo                   Int                         @default(1)
  cpfCnpj                String                      @db.VarChar(255) @map("cpf_cnpj")
  responsavel            String                      @db.VarChar(255)
  telefone               String                      @db.VarChar(255)
  email                  String                      @db.VarChar(255)
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  deletedAt              DateTime?                   @map("deleted_at")

  edital     EditalCredenciamento @relation(fields: [editalCredenciamentoId], references: [id])
  documentos SolicitacaoCredenciamentoDocumento[]
  historico  HistoricoCredenciamento[]

  @@map("solicitacoes_credenciamento")
}

model SolicitacaoCredenciamentoDocumento {
  id                         BigInt    @id @default(autoincrement())
  solicitacoesCredenciamentoId BigInt  @map("solicitacoes_credenciamento_id")
  documentoCredenciamentoId  BigInt    @map("documento_credenciamento_id")
  arquivoUrl                 String?   @map("arquivo_url") @db.Text
  nomeArquivo                String?   @db.VarChar(255) @map("nome_arquivo")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  solicitacao SolicitacaoCredenciamento @relation(fields: [solicitacoesCredenciamentoId], references: [id])
  documento   DocumentoCredenciamento   @relation(fields: [documentoCredenciamentoId], references: [id])

  @@map("solicitacoes_credenciamento_documentos")
}

model HistoricoCredenciamento {
  id                         BigInt                      @id @default(autoincrement())
  solicitacaoCredencimentoId BigInt                      @map("solicitacao_credencimento_id")
  userId                     String                      @map("user_id") @db.Uuid
  motivo                     String                      @db.VarChar(255)
  status                     StatusCredenciamentoEnum
  createdAt                  DateTime                    @default(now()) @map("created_at")
  updatedAt                  DateTime                    @updatedAt @map("updated_at")

  solicitacao SolicitacaoCredenciamento @relation(fields: [solicitacaoCredencimentoId], references: [id])

  @@index([solicitacaoCredencimentoId])
  @@map("historico_credenciamentos")
}

// ============================================================
// MÓDULO: AUDITORIA E LOGS
// ============================================================

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  dataHora    DateTime  @default(now()) @map("data_hora")
  userId      String?   @map("usuario_id") @db.Uuid
  usuarioNome String?   @map("usuario_nome") @db.Text
  ip          String?   @db.Text
  navegador   String?   @db.Text
  recurso     String?   @db.Text
  registroId  Int?      @map("registro_id")
  action      Int?      @db.SmallInt
  log         String?   @db.Text
  url         String?   @db.VarChar(255)

  @@index([userId])
  @@index([dataHora])
  @@map("audit_log")
}

// ============================================================
// MÓDULO: OUTROS / AUXILIARES
// ============================================================

model SolicitacaoAtualizacaoCadastral {
  id                    BigInt    @id @default(autoincrement())
  prestadorId           BigInt?   @map("prestador_id")
  conveniadoId          BigInt?   @map("conveniado_id")
  cidadeId              BigInt    @map("cidade_id")
  tipo                  Int       @db.SmallInt @default(1)
  dataSolicitacao       DateTime  @default(now()) @map("data_solicitacao") @db.Date
  endereco              String?   @db.VarChar(255)
  enderecoNro           String?   @db.VarChar(255) @map("endereco_nro")
  complemento           String?   @db.VarChar(255)
  bairro                String?   @db.VarChar(255)
  cep                   String?   @db.VarChar(255)
  email                 String?   @db.VarChar(255)
  telefone              String?   @db.VarChar(255)
  celular               String?   @db.VarChar(255)
  observacoes           String?   @db.VarChar(255)
  comprovanteEnderecoUrl String?  @map("comprovante_endereco_url") @db.VarChar(255)
  fotoUrl               String?   @map("foto_url") @db.VarChar(255)
  status                Int       @db.SmallInt @default(1)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  prestador  Prestador?  @relation(fields: [prestadorId], references: [id])
  conveniado Conveniado? @relation(fields: [conveniadoId], references: [id])
  cidade     Cidade      @relation(fields: [cidadeId], references: [id])

  @@map("solicitacoes_atualizacao_cadastral")
}

model FiscalContrato {
  id        BigInt    @id @default(autoincrement())
  userId    String    @map("usuario_id") @db.Uuid
  dataInicio DateTime @default(now()) @map("data_inicio") @db.Date
  dataFim   DateTime  @map("data_fim") @db.Date
  portaria  String    @db.VarChar(255)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  itens FiscalContratoItem[]

  @@map("fiscal_contratos")
}

model FiscalContratoItem {
  id              BigInt    @id @default(autoincrement())
  fiscalContratoId BigInt   @map("fiscal_contrato_id")
  contratoId      BigInt    @map("contrato_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  fiscalContrato FiscalContrato    @relation(fields: [fiscalContratoId], references: [id])
  contrato       PrestadorContrato @relation(fields: [contratoId], references: [id])

  @@map("fiscal_contrato_itens")
}

model CanalAtendimento {
  id        BigInt    @id @default(autoincrement())
  nome      String    @db.VarChar(255)
  telefone  String?   @db.VarChar(255)
  email     String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("canais_atendimento")
}

model Mensagem {
  id                  BigInt    @id @default(autoincrement())
  perfilId            BigInt?   @map("perfil_id")
  tipo                Int
  titulo              String    @db.VarChar(255)
  corpo               String    @db.Text
  idadeInicial        Int?      @map("idade_inicial")
  idadeFinal          Int?      @map("idade_final")
  dataInicialExibicao DateTime? @map("data_inicial_exibicao") @db.Date
  dataFinalExibicao   DateTime? @map("data_final_exibicao") @db.Date
  visivel             Boolean   @default(true)
  fixado              Boolean   @default(false)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@map("mensagens")
}

model Parametro {
  id             BigInt    @id @default(autoincrement())
  parameter      String    @db.VarChar(255)
  fieldLabel     String    @db.VarChar(255) @map("field_label")
  component      String?   @db.Text
  value          String?   @db.VarChar(255)
  possibleValues String?   @db.VarChar(255) @map("possible_values")
  deletedAt      DateTime? @map("deleted_at")

  @@map("parametros")
}
