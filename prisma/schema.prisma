model Guia {
  id                       BigInt                @id @default(autoincrement())
  operadoraId              BigInt                @map("operadora_id")
  prestadorId              BigInt?               @map("prestador_id")
  profissionalId           BigInt?               @map("profissional_id")
  conveniadoId             BigInt?               @map("conveniado_id")
  solicitantePrestadorId   BigInt?               @map("solicitante_prestador_id")
  lotePagamentoId          BigInt?               @map("lote_pagamento_id")
  guiaImportacaoId         BigInt?               @map("guia_importacao_id")
  guiaOrigemId             BigInt?               @map("guia_origem_id")
  canceladoPorUserId       String?               @map("cancelado_por_user_id") @db.Uuid
  usuarioEmissorId         String?               @map("usuario_emissor_id") @db.Uuid
  dataHora                 DateTime              @default(now()) @map("data_hora")
  tipoLancamento           Int                   @db.SmallInt @default(1) @map("tipo_lancamento")
  tipoAutorizacao          Int                   @db.SmallInt @default(1) @map("tipo_autorizacao")
  tipo                     TipoGuiaEnum          @default(CONSULTA)
  caraterAtendimento       CaraterAtendimentoEnum @default(ELETIVO) @map("carater_atendimento")
  indicacaoClinica         String?               @db.VarChar(255) @map("indicacao_clinica")
  observacoes              String?               @db.VarChar(255)
  observacoesInternas      String?               @db.VarChar(255) @map("observacoes_internas")
  urgente                  Boolean               @default(false)
  conferido                Boolean               @default(false)
  status                   StatusGuiaEnum        @default(SOLICITADA)
  dataHoraCancelamento     DateTime?             @map("data_hora_cancalamento")
  motivoCancelamento       String?               @db.VarChar(255) @map("motivo_cancelamento")
  justificaParaAuditoria   String?               @db.VarChar(255) @map("justifica_para_auditoria")
  loteImportacao           Int?                  @map("lote_importacao")
  numeroGuiaPrestador      Int?                  @map("numero_guia_prestador")
  dataAutorizacao          DateTime?             @map("data_autorizacao") @db.Date
  senha                    Int?
  dataValidadeSenha        DateTime?             @map("data_validade_senha") @db.Date
  tipoAutenticacao         Int?                  @db.SmallInt @map("tipo_autenticacao")
  codigoAutenticacao       String?               @db.VarChar(255) @map("codigo_autenticacao")
  autenticada              Boolean               @default(false)
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  deletedAt                DateTime?             @map("deleted_at")

  operadora          Operadora        @relation(fields: [operadoraId], references: [id])
  prestador          Prestador?       @relation("PrestadorGuia", fields: [prestadorId], references: [id])
  profissional       Prestador?       @relation("ProfissionalGuia", fields: [profissionalId], references: [id])
  solicitantePrestador Prestador?     @relation("SolicitanteGuia", fields: [solicitantePrestadorId], references: [id])
  conveniado         Conveniado?      @relation(fields: [conveniadoId], references: [id])
  lotePagamento      LotePagamento?   @relation(fields: [lotePagamentoId], references: [id])
  guiaImportacao     GuiaImportacao?  @relation(fields: [guiaImportacaoId], references: [id])
  guiaOrigem         Guia?            @relation("GuiaOrigem", fields: [guiaOrigemId], references: [id])
  guiasDerivadas     Guia[]           @relation("GuiaOrigem")
  itens              GuiaItem[]
  historico          GuiaHistorico[]
  anexos             GuiaAnexo[]
  lancamentosGuias   LancamentoGuia[]

  @@index([status])
  @@index([conveniadoId])
  @@index([prestadorId])
  @@index([operadoraId])
  @@map("guias")
}

model GuiaItem {
  id                         BigInt    @id @default(autoincrement())
  guiaId                     BigInt?   @map("guia_id")
  tipo                       TipoGuiaItemEnum @default(PROCEDIMENTO)
  referenciaTabela           String    @db.VarChar(255) @map("referencia_tabela")
  referenciaId               Int?      @map("referencia_id")
