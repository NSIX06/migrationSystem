// ============================================================
// ServSaúde — Prisma Schema
// Novo sistema: Next.js + Supabase PostgreSQL
// Gerado a partir da análise do banco legado
// ============================================================
//
// Decisões de design:
// - Auth via Supabase Auth (UUID); sem tabela `users` própria
// - Polimórficos eliminados — FKs explícitas por entidade
// - Enums tipados para todos os campos integer de status/tipo
// - Artefatos Laravel removidos (failed_jobs, migrations, menus, personal_access_tokens)
// - Soft delete padronizado com deletedAt em todas as entidades de negócio
// - Credenciais sensíveis fora do schema (env vars / Supabase Vault)
// - Campos `disk` substituídos por `fotoUrl`/`arquivoUrl` (Supabase Storage)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserTypeEnum {
  ADMIN
  GESTOR
  ATENDIMENTO
  FINANCEIRO
  AUDITORIA
  CREDENCIAMENTO
  BENEFICIARIO
  PRESTADOR
  VISUALIZADOR
}

enum UserStatusEnum {
  ATIVO
  INATIVO
  BLOQUEADO
  PENDENTE
}

enum SexoEnum {
  MASCULINO
  FEMININO
}

enum EstadoCivilEnum {
  SOLTEIRO
  CASADO
  SEPARADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  OUTRO
}

enum PcdEnum {
  SIM
  NAO
}

enum StatusAdesaoEnum {
  ATIVO
  SUSPENSO
  ENCERRADO
}

enum TipoClienteEnum {
  TITULAR
  DEPENDENTE
  AGREGADO
}

enum TipoPrestadorEnum {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

enum StatusGuiaEnum {
  SOLICITADA
  AUTORIZADA
  NEGADA
  EM_AUDITORIA
  CANCELADA
  FATURADA
}

enum TipoGuiaEnum {
  CONSULTA
  SADT
  INTERNACAO
  HONORARIO
  OUTROS
}

enum CaraterAtendimentoEnum {
  ELETIVO
  URGENCIA_EMERGENCIA
}

enum StatusLancamentoEnum {
  ABERTO
  PAGO
  CANCELADO
  VENCIDO
}

enum TipoLancamentoEnum {
  MENSALIDADE
  COPARTICIPACAO
  PAGAMENTO_PRESTADOR
  ESTORNO
  OUTROS
}

enum StatusBoletoEnum {
  EMITIDO
  PAGO
  CANCELADO
  VENCIDO
  BAIXADO_MANUALMENTE
}

enum StatusLoteEnum {
  ABERTO
  PROCESSADO
  PAGO
}

enum TipoGuiaItemEnum {
  PROCEDIMENTO
  MEDICAMENTO
  MATERIAL
  TAXA
  HONORARIO
}

enum TipoAbrangenciaEnum {
  MUNICIPAL
  ESTADUAL
  NACIONAL
}

enum TipoAcomodacaoEnum {
  ENFERMARIA
  APARTAMENTO
  UTI
}

enum TipoContratacaoEnum {
  COLETIVO_EMPRESARIAL
  COLETIVO_POR_ADESAO
  INDIVIDUAL
}

enum TipoCarenciaEnum {
  SEM_CARENCIA
  CARENCIA_PADRAO
  CARENCIA_REDUZIDA
}

enum StatusCredenciamentoEnum {
  SOLICITADO
  EM_ANALISE
  APROVADO
  REPROVADO
  CANCELADO
}

// ============================================================
// MÓDULO: GEOGRAFIA
// ============================================================

model Estado {
  id        BigInt    @id @default(autoincrement())
  nome      String    @db.VarChar(255)
  uf        String    @db.VarChar(2)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cidades              Cidade[]
  conveniados          Conveniado[]   @relation("OrgaoExpedidorUf")
  prestadores          Prestador[]    @relation("OrgaoExpedidorUfPrestador")
  prestadoresNat       Prestador[]    @relation("NaturalidadeEstadoPrestador")

  @@index([uf])
  @@map("estados")
}

model Cidade {
  id        BigInt    @id @default(autoincrement())
  estadoId  BigInt    @map("estado_id")
  nome      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  estado               Estado          @relation(fields: [estadoId], references: [id])
  conveniados          Conveniado[]    @relation("NaturalidadeCidade")
  prestadores          Prestador[]     @relation("NaturalidadeCidadePrestador")
  boletos              Boleto[]
  enderecos            Endereco[]
  solicitacoesAtualizacao SolicitacaoAtualizacaoCadastral[]

  @@index([estadoId])
  @@index([nome])
  @@map("cidades")
}

model Endereco {
  id         BigInt    @id @default(autoincrement())
  cidadeId   BigInt    @map("cidade_id")
  entidadeTipo String  @db.VarChar(50) @map("entidade_tipo")
  entidadeId BigInt    @map("entidade_id")
  tipo       Int
  cep        String    @db.Text
  logradouro String    @db.Text
  numero     String?   @db.Text
  complemento String?  @db.Text
  bairro     String?   @db.Text
  principal  Boolean   @default(false)
  ativo      Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  cidade Cidade @relation(fields: [cidadeId], references: [id])

  @@index([cidadeId])
  @@index([entidadeTipo, entidadeId])
  @@map("enderecos")
}

// ============================================================
// MÓDULO: ADMINISTRAÇÃO
// ============================================================

model Operadora {
  id                       BigInt    @id @default(autoincrement())
  nome                     String    @db.VarChar(255)
  razaoSocial              String    @db.VarChar(255) @map("razao_social")
  tipo                     Int       @db.SmallInt
  cpfCnpj                  String    @db.VarChar(255) @map("cpf_cnpj")
  inscricaoMunicipal       String?   @db.VarChar(255) @map("inscricao_municipal")
  inscricaoEstadual        String?   @db.VarChar(255) @map("inscricao_estadual")
  fone                     String?   @db.VarChar(255)
  email                    String?   @db.VarChar(255)
  codigoAns                String?   @db.VarChar(6) @map("codigo_ans")
  tipoDeclarante           Int       @map("tipo_declarante")
  cpfResponsavel           String    @db.VarChar(255) @map("cpf_responsavel")
  indicadorSituacaoDeclaracao String @db.VarChar(255) @map("indicador_situacao_declaracao")
  cnes                     String?   @db.VarChar(7)
  ativo                    Boolean   @default(true)
  percentualMaxDescontoCoparticipacao Decimal @default(24.9) @db.Decimal(8,2) @map("percentual_max_desconto_coparticipacao")
  // Boleto config (referências apenas — secrets em env vars)
  boletoNrConvenio         Int?      @map("boleto_nr_convenio")
  boletoNrCarteira         Int?      @map("boleto_nr_carteira")
  boletoAmbiente           Int?      @default(1) @map("boleto_ambiente")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  produtos     Produto[]
  usuarios     OperadoraUsuario[]
  boletos      Boleto[]
  lancamentos  Lancamento[]
  guias        Guia[]
  adesoes      Adesao[]

  @@unique([cpfCnpj])
  @@index([ativo])
  @@map("operadoras")
}

model Profile {
  // userId = UUID do Supabase Auth (sem FK — gerenciado pela auth)
  userId      String         @id @map("user_id") @db.Uuid
  nome        String         @db.VarChar(255)
  email       String         @db.VarChar(255)
  cpf         String?        @db.VarChar(14)
  fone        String?        @db.VarChar(20)
  userType    UserTypeEnum   @map("user_type")
  status      UserStatusEnum @default(ATIVO)
  conveniadoId BigInt?       @map("conveniado_id")
  prestadorId  BigInt?       @map("prestador_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at")

  conveniado   Conveniado?      @relation(fields: [conveniadoId], references: [id])
  prestador    Prestador?       @relation(fields: [prestadorId], references: [id])
  roles        UsuarioRole[]
  permissoes   PermissaoUsuario[]

  @@index([email])
  @@index([userType])
  @@index([status])
  @@map("profiles")
}

model Role {
  id        BigInt    @id @default(autoincrement())
  nome      String    @db.VarChar(255)
  slug      String    @db.VarChar(255)
  descricao String?   @db.VarChar(255)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  permissoes  RolePermissao[]
  usuarios    UsuarioRole[]

  @@unique([slug])
  @@map("roles")
}

model Permissao {
  id        BigInt    @id @default(autoincrement())
  modulo    String    @db.VarChar(255)
  nome      String    @db.VarChar(255)
  slug      String    @db.VarChar(255)
  ativo     Boolean   @default(true)
  descricao String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  roles     RolePermissao[]
  usuarios  PermissaoUsuario[]

  @@unique([slug])
  @@index([modulo])
  @@map("permissoes")
}

model RolePermissao {
  roleId      BigInt @map("role_id")
  permissaoId BigInt @map("permissao_id")

  role      Role      @relation(fields: [roleId], references: [id])
  permissao Permissao @relation(fields: [permissaoId], references: [id])

  @@id([roleId, permissaoId])
  @@map("role_permissoes")
}

model PermissaoUsuario {
  userId      String  @map("user_id") @db.Uuid
  permissaoId BigInt  @map("permissao_id")
  concedido   Boolean @default(true)

  profile   Profile   @relation(fields: [userId], references: [userId])
  permissao Permissao @relation(fields: [permissaoId], references: [id])

  @@id([userId, permissaoId])
  @@map("permissao_usuarios")
}

model UsuarioRole {
  userId String @map("user_id") @db.Uuid
  roleId BigInt @map("role_id")

  profile Profile @relation(fields: [userId], references: [userId])
  role    Role    @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("usuario_roles")
}

model OperadoraUsuario {
  operadoraId BigInt @map("operadora_id")
  userId      String @map("user_id") @db.Uuid

  operadora Operadora @relation(fields: [operadoraId], references: [id])

  @@id([operadoraId, userId])
  @@map("operadora_usuarios")
}

// ============================================================
// MÓDULO: EMPRESAS / CONVENIADAS
// ============================================================

model Empresa {
  id                BigInt    @id @default(autoincrement())
  tipo              Int       @db.SmallInt
  cpfCnpj           String    @db.VarChar(255) @map("cpf_cnpj")
  nome              String    @db.VarChar(255)
  razaoSocial       String    @db.VarChar(255) @map("razao_social")
  abreviado         String?   @db.Text
  fone              String?   @db.VarChar(255)
  email             String?   @db.VarChar(255)
  contato           String?   @db.VarChar(255)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  secretarias    Secretaria[]
  adesoes        Adesao[]
  verbas         EmpresaVerba[]
  produtos       EmpresaProduto[]
  usuarios       EmpresaUsuario[]
  remessas       RemessaDesconto[]

  @@unique([cpfCnpj])
  @@index([ativo])
  @@map("empresas")
}

model EmpresaUsuario {
  empresaId BigInt @map("empresa_id")
  userId    String @map("user_id") @db.Uuid

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@id([empresaId, userId])
  @@map("empresa_usuarios")
}

model Secretaria {
  id                BigInt    @id @default(autoincrement())
  empresaId         BigInt    @map("empresa_id")
  nome              String    @db.VarChar(255)
  razaoSocial       String    @db.VarChar(255) @map("razao_social")
  cpfCnpj           String?   @db.VarChar(255) @map("cpf_cnpj")
  abreviado         String?   @db.VarChar(255)
  fone              String?   @db.VarChar(255)
  email             String?   @db.VarChar(255)
  contato           String?   @db.VarChar(255)
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  adesoes Adesao[]

  @@index([empresaId])
  @@map("secretarias")
}

// ============================================================
// MÓDULO: BENEFICIÁRIOS
// ============================================================

model Cargo {
  id        BigInt    @id @default(autoincrement())
  descricao String    @db.VarChar(255)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  conveniados Conveniado[]

  @@map("cargos")
}

model Conveniado {
  id                    BigInt          @id @default(autoincrement())
  orgaoExpedidorUfId    BigInt?         @map("orgao_expedidor_uf_id")
  naturalidadeCidadeId  BigInt          @map("naturalidade_cidade_id")
  // userId = UUID do Supabase Auth (sem FK explícita — gerenciado pela auth)
  userId                String          @map("user_id") @db.Uuid
  cargoId               BigInt?         @map("cargo_id")
  nome                  String          @db.VarChar(255)
  cpf                   String          @db.VarChar(14)
  dataNascimento        DateTime        @map("data_nascimento") @db.Date
  sexo                  SexoEnum
  rg                    String?         @db.VarChar(255)
  orgaoExpedidor        String?         @db.VarChar(255) @map("orgao_expedidor")
  cns                   String?         @db.VarChar(255)
  nomePai               String?         @db.VarChar(255) @map("nome_pai")
  nomeMae               String          @db.VarChar(255) @map("nome_mae")
  fone1                 String?         @db.VarChar(255)
  fone2                 String?         @db.VarChar(255)
  email                 String?         @db.VarChar(255)
  fotoUrl               String?         @map("foto_url") @db.Text
  estadoCivil           EstadoCivilEnum @default(SOLTEIRO) @map("estado_civil")
  pcd                   PcdEnum         @default(NAO)
  ativo                 Boolean         @default(true)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")

  orgaoExpedidorUf     Estado?          @relation("OrgaoExpedidorUf", fields: [orgaoExpedidorUfId], references: [id])
  naturalidadeCidade   Cidade           @relation("NaturalidadeCidade", fields: [naturalidadeCidadeId], references: [id])
  cargo                Cargo?           @relation(fields: [cargoId], references: [id])
  adesoes              Adesao[]
  salarios             ConveniadoSalario[]
  gestante             Gestante?
  guias                Guia[]
  lancamentos          Lancamento[]
  mensalidades         Mensalidade[]
  solicitacoesAtualizacao SolicitacaoAtualizacaoCadastral[]
  profiles                Profile[]

  @@unique([cpf])
  @@index([ativo])
  @@index([userId])
  @@map("conveniados")
}

model ConveniadoSalario {
  id               BigInt    @id @default(autoincrement())
  conveniadoId     BigInt    @map("conveniado_id")
  salario          Decimal   @db.Decimal(8,2)
  dataCompetencia  DateTime  @map("data_competencia") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  conveniado Conveniado @relation(fields: [conveniadoId], references: [id])

  @@index([conveniadoId])
  @@map("conveniado_salarios")
}

model Gestante {
  id                   BigInt    @id @default(autoincrement())
  conveniadoId         BigInt    @unique @map("conveniado_id")
  dataInicioGestacao   DateTime  @default(now()) @map("data_inicio_gestacao") @db.Date
  dataFinalGestacao    DateTime? @map("data_final_gestacao") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  conveniado Conveniado @relation(fields: [conveniadoId], references: [id])

  @@map("gestantes")
}

model GrauParentesco {
  id        BigInt    @id @default(autoincrement())
  nome      String    @db.VarChar(255)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("grau_parentesco")
}

// ============================================================
// MÓDULO: PRODUTOS E PLANOS
// ============================================================

model TipoVinculo {
  id        BigInt    @id @default(autoincrement())
  tipo      Int       @db.SmallInt
  descricao String    @db.Text
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  produtosPrecos ProdutoPreco[]

  @@map("tipo_vinculos")
}

model Produto {
  id               BigInt             @id @default(autoincrement())
  operadoraId      BigInt             @map("operadora_id")
  descricao        String             @db.VarChar(255)
  abrangencia      TipoAbrangenciaEnum
  tipoContratacao  TipoContratacaoEnum @map("tipo_contratacao")
  tipoCarencia     TipoCarenciaEnum   @map("tipo_carencia")
  tipoAcomodacao   TipoAcomodacaoEnum @map("tipo_acomodacao")
  dataInicio       DateTime           @map("data_inicio") @db.Date
  dataFim          DateTime?          @map("data_fim") @db.Date
  ativo            Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  deletedAt        DateTime?          @map("deleted_at")

  operadora         Operadora           @relation(fields: [operadoraId], references: [id])
  precos            ProdutoPreco[]
  adesoes           Adesao[]
  empresas          EmpresaProduto[]
  regrasCopart      RegraCoparticipacao[]

  @@index([operadoraId])
  @@index([ativo])
  @@map("produtos")
}

model ProdutoPreco {
  id            BigInt    @id @default(autoincrement())
  produtoId     BigInt    @map("produto_id")
  tipoVinculoId BigInt?   @map("tipo_vinculo_id")
  grupoVerbaId  BigInt?   @map("grupo_verba_id")
  idadeInicial  Int       @map("idade_inicial")
  idadeFinal    Int       @map("idade_final")
  tipoCobranca  Int       @map("tipo_cobranca")
  tipoCliente   TipoClienteEnum @map("tipo_cliente")
  descricao     String    @db.VarChar(255)
  valor         Decimal   @db.Decimal(8,2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  produto      Produto      @relation(fields: [produtoId], references: [id])
  tipoVinculo  TipoVinculo? @relation(fields: [tipoVinculoId], references: [id])
  grupoVerba   GrupoVerba?  @relation(fields: [grupoVerbaId], references: [id])
  adesoes      Adesao[]
  mensalidades Mensalidade[]

  @@index([produtoId])
  @@map("produtos_precos")
}

model EmpresaProduto {
  empresaId BigInt @map("empresa_id")
  produtoId BigInt @map("produto_id")

  empresa Empresa @relation(fields: [empresaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([empresaId, produtoId])
  @@map("empresa_produtos")
}

model RegraCoparticipacao {
  id                    BigInt    @id @default(autoincrement())
  produtoId             BigInt    @map("produto_id")
  nome                  String    @db.Text
  tempoCarencia         Int?      @map("tempo_carencia")
  carencia              Boolean
  semLimiteParaGestante Boolean   @default(false) @map("sem_limite_para_gestante")
  auditoria             Boolean
  ativo                 Boolean
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  produto     Produto                     @relation(fields: [produtoId], references: [id])
  itens       RegraCoparticipacaoItem[]
  procedimentos RegraCoparticipacaoProcedimento[]

  @@index([produtoId])
  @@map("regras_coparticipacao")
}

model RegraCoparticipacaoItem {
  id                      BigInt    @id @default(autoincrement())
  regraCoparticipacaoId   BigInt    @map("regra_coparticipacao_id")
  qtdeInicial             Int       @map("qtde_inicial")
  qtdeFinal               Int       @map("qtde_final")
  percentualCoparticipacao Decimal  @db.Decimal(8,2) @map("percentual_coparticipacao")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  regra RegraCoparticipacao @relation(fields: [regraCoparticipacaoId], references: [id])

  @@map("regras_coparticipacao_itens")
}

model RegraCoparticipacaoProcedimento {
  id                    BigInt    @id @default(autoincrement())
  tipo                  Int       @db.SmallInt @default(1)
  regraCoparticipacaoId BigInt    @map("regra_coparticipacao_id")
  grupoProcedimentoId   Int       @map("grupo_procedimento_id")
  subgrupoProcedimentoId Int?     @map("subgrupo_procedimento_id")
  procedimentoId        Int?      @map("procedimento_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  regra              RegraCoparticipacao    @relation(fields: [regraCoparticipacaoId], references: [id])
  grupoProcedimento  ProcedimentoGrupo      @relation(fields: [grupoProcedimentoId], references: [id])
  subgrupoProcedimento ProcedimentoSubgrupo? @relation(fields: [subgrupoProcedimentoId], references: [id])
  procedimento       Procedimento?          @relation(fields: [procedimentoId], references: [id])

  @@map("regras_coparticipacao_procedimentos")
}

// ============================================================
// MÓDULO: ADESÕES
// ============================================================

model MotivoEncerramento {
  id        BigInt    @id @default(autoincrement())
  motivo    String    @db.VarChar(255)
  tipo      Int       @db.SmallInt @default(1)
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
